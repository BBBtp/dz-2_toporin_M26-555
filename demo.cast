[0.965, "o", "DB project is running!\r\n\r\n***Примитивная база данных***\r\ncreate_table <таблица> <столбец:тип> ... — создать таблицу\r\nlist_tables — показать все таблицы\r\ndrop_table <таблица> — удалить таблицу\r\ninsert into <таблица> values (\"строка\", 28, true) — добавить запись\r\nselect from <таблица> [where <столбец> = <значение>] — выборка\r\nupdate <таблица> set <столбец> = <значение> where ... — обновление\r\ndelete from <таблица> where <столбец> = <значение> — удаление\r\ninfo <таблица> — структура и количество записей\r\nhelp — справка; exit — выход\r\n\r\n"]
[0.967062, "o", "Введите команду: "]
[12.295686, "o", "create_table users name:str age:int is_active:bool\r\n"]
[12.297434, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[12.297535, "o", "Введите команду: "]
[13.402689, "o", "insert into users values (\"Sergei\", 28, true)\r\n"]
[13.40304, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[13.403281, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[13.403335, "o", "Введите команду: "]
[14.510924, "o", "select from users where age = 28\r\n"]
[14.511389, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[14.567376, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[14.567471, "o", "Введите команду: "]
[15.613337, "o", "update users set age = 29 where name = \"Sergei\"\r\n"]
[15.614082, "o", "В таблице \"users\" обновлено записей: 1.\r\nВведите команду: "]
[16.722006, "o", "select from users\r\n"]
[16.722289, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[16.722463, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[16.72261, "o", "Введите команду: "]
[26.022037, "o", "delete from users where ID = 1\r\n"]
[26.02257, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[27.126934, "o", "y\r\n"]
[27.127553, "o", "Из таблицы \"users\" удалено записей: 1.\r\n"]
[27.127685, "o", "Введите команду: "]
[28.233508, "o", "drop_table users\r\n"]
[28.233677, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[29.342431, "o", "y\r\n"]
[29.343226, "o", "Таблица \"users\" успешно удалена.\r\n"]
[29.343301, "o", "Введите команду: "]
[30.447779, "o", "exit\r\n"]
[30.448011, "o", "Работа завершена.\r\n"]
